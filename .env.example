# Names only. Load real values from a restricted file outside this checkout.
DATABASE_URL=
VIBETOKEN_API_KEY=
GOOGLE_CLIENT_ID=
GA_MEASUREMENT_ID=
# GA4 Measurement Protocol API secret for server-side purchase events; empty disables them.
GA_API_SECRET=
# "true" marks Measurement Protocol events for GA DebugView; leave empty in normal operation.
GA_MP_DEBUG=
SESSION_SECRET=
DEMO_ACCESS_CODE=
APP_URL=
GENERATION_DAILY_LIMIT=
# Docker Compose database bootstrap (the URL above must match these values).
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PASSWORD=

# Isolated Pancake test deployment only. No variable enables live sales.
BILLING_TEST_ENABLED=
BILLING_DEPLOYMENT_MODE=
BILLING_TEST_APP_ORIGIN=
PANCAKE_TEST_MERCHANT_ID=
PANCAKE_TEST_STORE_ID=
PANCAKE_TEST_PRODUCT_ID=
PANCAKE_TEST_PRIVATE_KEY=
PANCAKE_TEST_PLATFORM_PUBLIC_KEY=

# Explicit preparation validates live config and enables callbacks/query recovery,
# no public checkout. Refund requests retain existing business checks.
BILLING_LIVE_PREPARATION_ENABLED=
# Optional one-account, one-order live acceptance window (maximum 24h).
# All three are required; real values stay outside this checkout.
BILLING_LIVE_PILOT_USER_ID=
BILLING_LIVE_PILOT_REQUEST_ID=
BILLING_LIVE_PILOT_EXPIRES_AT=
# Live collection additionally requires a future code-approved release.
BILLING_LIVE_ENABLED=
BILLING_LIVE_APP_ORIGIN=
PANCAKE_LIVE_MERCHANT_ID=
PANCAKE_LIVE_STORE_ID=
PANCAKE_LIVE_PRODUCT_ID=
PANCAKE_LIVE_PRIVATE_KEY=
PANCAKE_LIVE_PLATFORM_PUBLIC_KEY=
